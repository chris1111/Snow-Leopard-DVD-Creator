#!/bin/bash
# Installer Mac OS X Snow Leopard
# (c) Copyright 2026 chris1111
# This will create an iso of Mac OS X Snow Leopard
# Refactored: same steps, fixed validation, added checks and auto-cleanup.
set -u

# --- configuration ----------------------------------------------------------------
APPTITLE="Installer Mac OS X Snow Leopard"
VERSION="1.0"
ICON="/System/Library/CoreServices/Finder.app/Contents/Resources/Finder.icns"

DVD_MOUNT="/Volumes/Mac-OSX-Install-DVD"
SPARSE="/private/tmp/MacOS.sparseimage"
ISO="$HOME/Desktop/Mac OS X Install DVD.iso"

# --- helpers ------------------------------------------------------------------------
banner() {
    printf '\n**********************************************\n%s\n**********************************************\n' "$*"
}

notify() {
    osascript -e "display notification \"$1\" with title \"$APPTITLE\" subtitle \"$2\"" >/dev/null 2>&1 || true
}

cancelled() {
    notify "Program closing" "User cancelled"
    exit 0
}

focus_terminal() {
    osascript -e 'tell application "Terminal" to activate' >/dev/null 2>&1 || true
}

fail() {
    echo "ERROR: $*" >&2
    dialog_ok "ERROR: $*"
    exit 1
}

dialog_ok() {
    osascript - "$1" "$APPTITLE $VERSION" "$ICON" >/dev/null 2>&1 <<'OSA'
on run {msg, ttl, iconFile}
    tell application "System Events"
        display dialog msg buttons {"OK"} default button 1 with title ttl with icon POSIX file iconFile giving up after 8
    end tell
end run
OSA
}

intro_dialog() {
    local msg
    msg=$(printf '%s\n\n%s\n%s\n\n%s' \
        "This program will create a bootable ISO image of Mac OS X Snow Leopard." \
        "NOTE:" \
        "You can create an ISO of Mac OS X Snow Leopard 10.6.7 only! If a \"Mac OS X Install DVD.iso\" already exists on the Desktop it will be deleted by this script. Move any images you want to keep elsewhere before continuing." \
        "Select OK to continue, Cancel to quit.")
    osascript - "$msg" "$APPTITLE $VERSION" "$ICON" >/dev/null 2>&1 <<'OSA'
on run {msg, ttl, iconFile}
    tell application "System Events"
        display dialog msg buttons {"Cancel", "OK"} default button 2 with title ttl with icon POSIX file iconFile
    end tell
end run
OSA
}

choose_dmg() {
    osascript 2>/dev/null <<EOT
tell application "Finder"
    activate
    set f to choose file default location "$HOME/Desktop" with prompt "Choose your Mac OS X Install DVD.dmg"
    return POSIX path of f
end tell
EOT
}

# --- always clean up, even on error or Ctrl-C ------------------------------------------
cleanup() {
    hdiutil detach -force "$DVD_MOUNT" >/dev/null 2>&1 || true
    hdiutil detach -force "/Volumes/Mac OS X Install DVD" >/dev/null 2>&1 || true
    [ -e "$SPARSE" ] && rm -rf "$SPARSE"
    true
}
trap cleanup EXIT

# --- start --------------------------------------------------------------------------------
[ "$(uname)" = "Darwin" ] || { echo "This script must run on macOS." >&2; exit 1; }

PARENTDIR=$(dirname "$0")
cd "$PARENTDIR" || exit 1
find . -name '.DS_Store' -type f -delete 2>/dev/null

intro_dialog || cancelled

banner "Starting Mac OS X Install DVD!"

# detach leftovers from previous runs
hdiutil detach -force "$DVD_MOUNT" >/dev/null 2>&1 || true
hdiutil detach -force "/Volumes/Mac OS X Install DVD" >/dev/null 2>&1 || true
[ -e "$SPARSE" ] && rm -rf "$SPARSE"

# --- choose the DMG --------------------------------------------------------------------
DMG_PATH="$(choose_dmg)" || cancelled
[ -n "$DMG_PATH" ] || cancelled
echo "Selected: $DMG_PATH"

# extension check — all three cases handled (the original let non-.dmg/.iso files through)
case "$DMG_PATH" in
    *.dmg|*.DMG)
        echo "The file is a DMG image ✅"
        ;;
    *.iso|*.ISO)
        echo "The file is not a DMG image 🚫
You need to use a DMG of Mac OS X Install DVD!
Convert your image then retry."
        dialog_ok "You need to use a DMG of Mac OS X Install DVD. Convert your image then retry."
        exit 0
        ;;
    *)
        fail "This is not a DMG image. Please choose the Mac OS X Install DVD.dmg."
        ;;
esac

hdiutil imageinfo "$DMG_PATH" >/dev/null 2>&1 || fail "This file can't be read as a disk image."

# --- size check (6 GB = 6000 MB) -----------------------------------------------------------
SIZE_MB=$(du -sm "$DMG_PATH" | awk '{print $1}')
if [ "$SIZE_MB" -lt 6000 ]; then
    echo "This image is lower than 6 GB ($SIZE_MB MB)."
    dialog_ok "You need the 10.6.7 Image! This is not good."
    exit 0
fi
echo "Success: this image is 6 GB or larger ($SIZE_MB MB)."
dialog_ok "Reminder: You need an 8.5 GB DVD Double Layer for this image."

# --- convert ------------------------------------------------------------------------------
echo "Converting the image (this can take a while)..."
hdiutil convert "$DMG_PATH" -format UDSP -o /private/tmp/MacOS || fail "hdiutil convert failed."
[ -f "$SPARSE" ] || fail "The sparse image was not created."
hdiutil resize -size 8.1g "$SPARSE" 2>/dev/null || echo "Keeping the original size (source is already 8.1 GB or more)."
sleep 2

# old ISO is deleted only now, once we are committed (same order as the original)
[ -e "$ISO" ] && { echo "Removing existing: $ISO"; rm -f "$ISO"; }

# --- mount and populate ---------------------------------------------------------------------
mkdir -p "$DVD_MOUNT"
hdiutil attach "$SPARSE" -noverify -nobrowse -mountpoint "$DVD_MOUNT" || fail "Could not mount the sparse image."
focus_terminal

echo "Copying the package..."
mkdir -p "$DVD_MOUNT/Snow DVD Creator"
cp -Rp ./* "$DVD_MOUNT/Snow DVD Creator/" || fail "Could not copy the package to the DVD volume."

# --- Chameleon: PC or Laptop -------------------------------------------------------------------
banner "Install Chameleon!"
echo "Select 1 for PC or 2 for Laptop."
PS3="Please enter your choice (1-2): "
select opt in "PC" "Laptop"; do
    case "$opt" in
        PC)
            echo "You selected PC."
            [ -d "./DVD-PC" ] || fail "Missing folder: ./DVD-PC"
            cp -Rp ./DVD-PC/* "$DVD_MOUNT/" || fail "DVD-PC copy failed."
            break
            ;;
        Laptop)
            echo "You selected Laptop."
            [ -d "./DVD-Lptop" ] || fail "Missing folder: ./DVD-Lptop"
            cp -Rp ./DVD-Lptop/* "$DVD_MOUNT/" || fail "DVD-Lptop copy failed."
            break
            ;;
        *) echo "Invalid option. Try again." ;;
    esac
done

# --- log -----------------------------------------------------------------------------------------
mkdir -p "$DVD_MOUNT/Extra"
install_log="$DVD_MOUNT/Extra/Chameleon_Install_Log.txt"
{
    echo ""
    echo "Chameleon installer log - $(date)"
    echo "Installer version: Chameleon - v2.4svn -rev 2923"
    echo "Built: > By chris1111"
    echo "Build Xcode Version 9.4.1 (9F2000)"
    echo "======================================================"
    diskutil list
    echo "======================================================"
    echo "========== Using cdboot to $DVD_MOUNT ============"
    echo "============= No Active Partition ==================="
    echo "=========== Chameleon Installation Finish ==========="
} > "$install_log"

sleep 2
chflags hidden "$DVD_MOUNT/usr" 2>/dev/null || true

# --- shrink, remount, makehybrid ---------------------------------------------------------------------
hdiutil detach -force "$DVD_MOUNT"
hdiutil resize -size "$(hdiutil resize -limits "$SPARSE" | tail -n 1 | awk '{print $1}')b" "$SPARSE"
sleep 2
hdiutil attach "$SPARSE" -noverify -nobrowse -mountpoint "$DVD_MOUNT" || fail "Could not re-mount the sparse image."
focus_terminal

CDBOOT="$DVD_MOUNT/usr/standalone/i386/cdboot"
[ -f "$CDBOOT" ] || fail "cdboot not found — is this really the Mac OS X Install DVD?"

banner "Create ISO image — type your password!"
sudo hdiutil makehybrid -o "$ISO" "$DVD_MOUNT" -iso -hfs -joliet \
    -eltorito-boot "$CDBOOT" -no-emul-boot \
    -hfs-volume-name "Mac OS X Install DVD" \
    -joliet-volume-name "Mac OS X Install DVD" || fail "makehybrid failed."
[ -f "$ISO" ] || fail "The ISO was not created."

banner "Unmount installer image!"
sleep 1
hdiutil detach -force "$DVD_MOUNT"
sleep 1
rm -rf "$SPARSE"

# --- burn or exit --------------------------------------------------------------------------------------
banner "Burning DVD!"
PS3="Please enter your choice (1-2): "
select opt in "Burn the DVD" "Exit"; do
    case "$opt" in
        "Burn the DVD")
            echo "You selected Burn the DVD."
            hdiutil burn -noverifyburn "$ISO" || echo "Burning failed."
            sleep 1
            open -R "$ISO"
            break
            ;;
        "Exit")
            echo "You selected to Quit."
            sleep 1
            open -R "$ISO"
            break
            ;;
        *) echo "Invalid option. Try again." ;;
    esac
done

banner "Mac OS X Install DVD Done!"
exit 0